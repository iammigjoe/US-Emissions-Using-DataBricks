{
  "datasets": [
    {
      "name": "f830e6e8",
      "displayName": "Locations Data",
      "queryLines": [
        "SELECT latitude,\n",
        "longitude,\n",
        "'GHG emisssions mtons CO2e' as Emissions\n",
        "FROM emissions.default.emissions_data"
      ]
    },
    {
      "name": "20b2d87e",
      "displayName": "Emissions per Person",
      "queryLines": [
        "SELECT county_state_name,\n",
        "       population,\n",
        "       CAST(\n",
        "         REPLACE(`GHG emissions mtons CO2e`, ',', '')\n",
        "         AS DOUBLE\n",
        "       ) / NULLIF(\n",
        "        CAST(\n",
        "          REPLACE(population, ',', '')\n",
        "          AS DOUBLE\n",
        "        ), 0\n",
        "       ) AS Emissions_per_person\n",
        "FROM emissions_data\n",
        "ORDER BY emissions_per_person DESC"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "a156e3b3",
      "displayName": "Total Emissions Per State",
      "queryLines": [
        "SELECT state_abbr,\n",
        "       SUM(CAST(\n",
        "         REPLACE(`GHG emissions mtons CO2e`, ',', '')\n",
        "         AS DOUBLE\n",
        "       )) AS Total_Emissions\n",
        "FROM emissions_data\n",
        "GROUP BY state_abbr\n",
        "ORDER BY Total_Emissions DESC\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "82850483",
      "displayName": "County Shaming",
      "queryLines": [
        "SELECT county_state_name,\n",
        "       population,\n",
        "       CAST(\n",
        "         REPLACE(`GHG emissions mtons CO2e`, ',', '')\n",
        "         AS DOUBLE) AS Total_Emissions\n",
        "FROM emissions_data\n",
        "ORDER BY Total_Emissions DESC\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
